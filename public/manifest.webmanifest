{
  "name": "RITE",
  "short_name": "RITE",
  "description": "Ranked honesty fitness. Heat rises and falls. No paywall.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070605",
  "theme_color": "#0a0908",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log breakfast",
      "short_name": "Breakfast",
      "url": "./?slot=breakfast",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log lunch",
      "short_name": "Lunch",
      "url": "./?slot=lunch",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Log dinner",
      "short_name": "Dinner",
      "url": "./?slot=dinner",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Quick kcal",
      "short_name": "Quick kcal",
      "url": "./?quick=1",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
